# OpenAQ API key: create one at https://explore.openaq.org/register
OPENAQ_API_KEY=replace-with-your-openaq-api-key

# OpenAQ API root
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Local DuckDB warehouse
AIRQ_DUCKDB_PATH=warehouse.duckdb

# Cities used by the first ingestion run (comma-separated).
# These are OpenAQ location IDs, not city names.
OPENAQ_LOCATION_IDS=

# Optional: ISO country code used to discover locations.
OPENAQ_COUNTRY_CODE=MA

# Number of days to request from each sensor.
AIRQ_HISTORY_DAYS=7

# Maximum pages fetched per sensor.
AIRQ_MAX_PAGES=10
